# SmartCrop Backend Configuration

# SMS Provider Configuration
# Choose: fast2sms | twilio | mock
SMS_PROVIDER=fast2sms

# Fast2SMS Credentials (Recommended for Indian 10-digit mobile numbers)
# Sign up at https://www.fast2sms.com and get your API key from Dev API section
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio Credentials (Optional for Global SMS)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_phone

# Security & OTP Settings
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_LENGTH=6
